# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore

.gcloudignore
.git
.gitignore

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
myenv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Data files - Allow CSVs for pipeline to work
# Daily Sheet Data Cleaned/
# Daily Sheet Data Cleaned Whole and Half/
# *.csv
# *.xlsx

# Output files
outputs/

# OS files
.DS_Store
Thumbs.db

# Documentation
README.md
*.md

# Test files
tests/
test_*.py

# Node modules (if you have any frontend stuff)
node_modules/